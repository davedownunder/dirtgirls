---
const testimonials = [
  {
    quote: "Definitely consider Dirt Girls for your Gardening needs. Very very happy with my garden makeover and tidy. Reliable, nothing was too much trouble and definitely hard working. They got in there and got the job done. Awesome ladies… Thank you",
    author: "May Williams",
  },
];
---

<div class="testimonial-carousel" aria-label="Customer testimonials" role="region">
  {testimonials.map((t) => (
    <div class="testimonial active" role="group">
      <blockquote>
        &ldquo;{t.quote}&rdquo;
      </blockquote>
      <cite>&mdash; {t.author}</cite>
    </div>
  ))}
</div>
